# Public Supabase project connection (safe to expose only the publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Reown/WalletConnect Cloud project ID for mobile and QR wallet support.
# Restrict it to this app's exact production origin in the Reown allowlist.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Server-only emergency/bootstrap preview wallets, comma-separated. Manage
# normal access in /admin/settings; a disabled database row overrides this list.
ADMIN_PREVIEW_WALLETS=

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes encoded as base64. Used only for AES-256-GCM at rest.
APP_ENCRYPTION_KEY=

# A separate long random value used to sign admin and wallet-session cookies.
SESSION_SECRET=

# Canonical application origin, with no trailing slash.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Public launch state for the Cabi application.
#
# Effective mode is the FIRST of these that applies:
#   1. SITE_MODE_OVERRIDE (below)        - emergency deployment override
#   2. app_settings.site_mode            - the /admin/settings -> Website mode control
#   3. PRELAUNCH                         - safe fallback until an owner launches
#
# Leave this BLANK for normal operation. The owner switches between LIVE,
# PRELAUNCH, and MAINTENANCE from the dashboard, with no redeploy. Set it only to
# force a mode in an emergency; while it is set, the dashboard cannot override it.
#
# This is read on the server only and is deliberately NOT a NEXT_PUBLIC_ variable:
# it is an access-control input, so it must never be inlined into a client bundle.
#
# Values: PRELAUNCH | LIVE | MAINTENANCE
SITE_MODE_OVERRIDE=
#
# Deprecated alias, still honoured so an existing deployment keeps working.
# Prefer SITE_MODE_OVERRIDE. NEXT_PUBLIC_SITE_MODE is no longer read at all.
# SITE_MODE=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Published $CPU token destination (optional).
#
# The repository intentionally ships no contract address and no Clank.trade link,
# so nothing unverified can be presented as official. Publish them here or enter
# them at /admin/cpu. Either way the value is only shown to the public once the
# $CPU launch status in /admin/cpu is LIVE.
#
# CPU_CONTRACT_ADDRESS=0x...
# CPU_CLANK_TRADE_URL=https://clank.trade/coin/0x...
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# $CPU holder access gate (server-only).
#
# Access to the Cabi application requires holding at least 1,000,000 $CPU while
# the site is LIVE. The gate ships with the official contract, chain, and buy
# URL built in:
#
#   contract  0x1a421a5065316d9b4062939e9959ddece6630528
#   chain     4663 (Robinhood Chain)
#   buy page  https://clank.trade/coin/0x1a421a5065316d9b4062939e9959ddece6630528
#
# Normal operation needs NONE of the variables below: the minimum, the gate
# switch, and the admin bypass are managed in /admin/cpu, validated server-side,
# and written to the audit log. They are listed so an owner can override the
# deployment without touching the dashboard. All are read on the server only.
#
# CPU_HOLDER_GATE_ENABLED=true            # cpu_holder_gate_enabled
# CPU_GATE_ALLOW_ADMIN_BYPASS=true        # approved owner wallets skip the gate
# CPU_ACCESS_TOKEN_ADDRESS=0x...          # must be a valid EVM address
# CPU_ACCESS_CHAIN_ID=4663
# CPU_ACCESS_RPC_URL=https://...          # HTTPS, no embedded credentials
# ---------------------------------------------------------------------------

# Separate admin login. ADMIN_PASSWORD_HASH uses:
# pbkdf2-sha256$<iterations>$<base64url-salt>$<base64url-derived-key>
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Optional server-only DeepSeek fallback. Admin-saved configuration takes priority.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_TEMPERATURE=0.8
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Cabi image generation (Together AI)
#
# Server-only. Never prefix this with NEXT_PUBLIC_ and never import it into a
# client component: it would end up in the browser bundle.
#
# Add the real key to .env.local (git-ignored) and to your hosting provider's
# environment variables. Leave the value blank in this file.
#
# The admin panel can also hold the key, encrypted at rest with
# APP_ENCRYPTION_KEY. A key set here is the fallback when none is saved.
# ---------------------------------------------------------------------------
TOGETHER_API_KEY=

# Which image provider is active. Together AI is the shipped default.
IMAGE_PROVIDER=together

# Image model. Defaults to Qwen/Qwen-Image when unset.
#
# Cabi's character consistency has two layers: the fixed character bible in
# lib/cabi/image-identity.ts, which every model uses, and the official reference
# image. Whether the reference is *conditioned on* depends on this model:
#
#   Qwen/Qwen-Image                text-to-image  -> bible only
#   Qwen/Qwen-Image-Edit           image input    -> bible + reference
#   black-forest-labs/FLUX.1-Kontext-pro|max       -> bible + reference
#
# The admin console at /admin/images reports which case applies and never sends a
# reference parameter to a model that cannot use one. Switching to a
# reference-capable model makes the active reference apply automatically.
TOGETHER_IMAGE_MODEL=Qwen/Qwen-Image
